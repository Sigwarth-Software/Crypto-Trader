{
    "name": "@Sigwarth-Software/crypto-trader-website",
    "version": "0.2.0",
    "description": "The web interface for Crypto Trader.",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": {
            "import": "./index.js"
        },
        "./angular/*": "./angular/*"
    },
    "files": [
        "index.js",
        "angular/**"
    ],
    "sideEffects": false,
    "scripts": {
        "prebuild": "node scripts/generate-env.mjs",
        "prestart": "node scripts/generate-env.mjs",
        "pretest": "node scripts/generate-env.mjs",
        "start": "ng serve",
        "start:https": "ng serve --configuration development --ssl true --ssl-cert ../certs/localhost.pem --ssl-key ../certs/localhost-key.pem --proxy-config proxy.local-https.conf.json",
        "serve": "ng serve",
        "build": "ng build --configuration production",
        "build:dev": "ng build --configuration development",
        "docs:generate": "compodoc -c .compodocrc.json",
        "test": "ng test",
        "test:jest": "jest --config jest.config.cjs",
        "test:jest:watch": "jest --config jest.config.cjs --watch",
        "g:c": "tsx scripts/generate-component.ts",
        "lint": "eslint . --cache --concurrency=auto && stylelint \"**/*.scss\"",
        "lint:fix": "eslint . --fix --cache --concurrency=auto && stylelint \"**/*.scss\" --fix",
        "format": "prettier . --write && stylelint \"**/*.scss\" --fix && node scripts/fix-format.mjs",
        "format:check": "prettier . --check",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sigwarth-Software/Crypto-Trader.git",
        "directory": "Crypto-Trader-Website"
    },
    "bugs": {
        "url": "https://github.com/Sigwarth-Software/Crypto-Trader/issues"
    },
    "homepage": "https://github.com/Sigwarth-Software/Crypto-Trader#readme",
    "author": "Sigwarth-Software",
    "license": "ISC",
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "crypto",
        "trader",
        "angular",
        "website"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
