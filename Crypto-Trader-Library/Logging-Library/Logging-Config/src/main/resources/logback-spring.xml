<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="strip" class="org.cryptotrader.logging.logback.AnsiStripperConverter"/>

    <springProperty scope="context" name="ct_console_level" source="crypto-trader-logging.level.console" defaultValue="INFO"/>
    <springProperty scope="context" name="ct_file_level" source="crypto-trader-logging.level.file" defaultValue="TRACE"/>
    <springProperty scope="context" name="ct_console_pattern" source="cryptotrader.logging.console-pattern"/>
    <springProperty scope="context" name="ct_file_pattern" source="cryptotrader.logging.file-pattern"/>
    <springProperty scope="context" name="ct_error_file_pattern" source="cryptotrader.logging.error-file-pattern"/>
    <springProperty scope="context" name="ct_exception_word" source="cryptotrader.logging.exception-conversion-word"/>
    <springProperty scope="context" name="ct_app_name" source="spring.application.name" defaultValue="unknown-service"/>
    <springProperty scope="context" name="ct_persistence_mode" source="cryptotrader.logging.persistence.mode" defaultValue="DATABASE"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                ${ct_console_pattern:-%clr(%d{MM/dd/yyyy - HH:mm:ss, America/Chicago}){faint} %clr(%5p) %clr(%logger{36}){cyan} %clr(-){faint} %m%n${ct_exception_word:-${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}}
            </pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${ct_console_level}</level>
        </filter>
    </appender>

    <appender name="ALL_LOGS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>./logs/all-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>${ct_file_pattern:-%d{yyyy-MM-dd HH:mm:ss.SSS, America/Chicago} %-5level %logger{36} - %strip(%msg)%n}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${ct_file_level}</level>
        </filter>
    </appender>

    <appender name="BUGS_LOGS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>./logs/bugs-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>
                ${ct_error_file_pattern:-%d{yyyy-MM-dd HH:mm:ss.SSS, America/Chicago} %-5level %logger{36} - %strip(%msg)%n${ct_exception_word:-${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}}
            </pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <appender name="APPLICATION_LOG_KAFKA" class="org.cryptotrader.logging.logback.ApplicationLogKafkaAppender"/>

    <appender name="ASYNC_APPLICATION_LOG_KAFKA" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="APPLICATION_LOG_KAFKA"/>
        <includeCallerData>false</includeCallerData>
    </appender>

    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.apache.kafka.clients" level="WARN"/>
    <logger name="org.apache.kafka.common.metrics" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_LOGS"/>
        <appender-ref ref="BUGS_LOGS"/>
    </root>

    <logger name="org.cryptotrader" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ALL_LOGS"/>
        <appender-ref ref="BUGS_LOGS"/>
        <appender-ref ref="ASYNC_APPLICATION_LOG_KAFKA"/>
    </logger>
</configuration>