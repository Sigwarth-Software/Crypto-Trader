<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.cryptotrader.admin.controller.TablesController"
      spacing="20" alignment="CENTER"
      style="-fx-padding: 40;">

    <Label text="Available Data Tables" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <VBox spacing="10" alignment="CENTER">
        <Button text="User Data" onAction="#onUserDataClick" maxWidth="200"/>
        <Button text="Ban Offenses" onAction="#onBanOffensesClick" maxWidth="200"/>
        <Button text="Warn Offenses" onAction="#onWarnOffensesClick" maxWidth="200"/>
    </VBox>

</VBox>
